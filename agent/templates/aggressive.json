{
  "name": "Aggressive Wide Net",
  "description": "Maximum opportunity capture with higher risk tolerance",
  "template": "aggressive",
  "marketFilters": {
    "excludeSports": false,
    "excludeMeme": false,
    "minVolume": 5000,
    "priceRange": {
      "min": 5,
      "max": 95
    },
    "maxDaysToResolution": 365
  },
  "intelligenceSources": {
    "hackernews": true,
    "reddit": true,
    "bbc": true,
    "googleNews": true,
    "nitter": true,
    "customKeywords": ["breaking", "urgent", "confirmed", "leaked", "insider", "rumor", "trend", "viral", "meme", "hype"]
  },
  "riskParameters": {
    "budget": 200,
    "maxPerPosition": 25,
    "maxConcurrentPositions": 8,
    "minEdgeThreshold": 0.03,
    "kellyFraction": 0.5
  },
  "execution": {
    "autoExecute": false,
    "cronInterval": "1h"
  },
  "strategy": {
    "focus": "maximum opportunity capture",
    "approach": "Cast a wide net across all market types, including sports and meme markets, with faster execution",
    "targetMarkets": [
      "All geopolitical and economic events",
      "Sports outcomes with information edges",
      "Technology and gaming events",
      "Social media and cultural trends",
      "Cryptocurrency market events",
      "Entertainment and meme markets"
    ],
    "avoidMarkets": [
      "Markets with insufficient liquidity",
      "Extremely long-term speculation (>1 year)"
    ]
  }
}