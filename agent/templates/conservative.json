{
  "name": "Conservative Resolution Sniping",
  "description": "High-certainty outcome targeting with minimal risk",
  "template": "conservative",
  "marketFilters": {
    "excludeSports": true,
    "excludeMeme": true,
    "minVolume": 50000,
    "priceRange": {
      "min": 88,
      "max": 97
    },
    "maxDaysToResolution": 30
  },
  "intelligenceSources": {
    "hackernews": true,
    "reddit": false,
    "bbc": true,
    "googleNews": true,
    "nitter": false,
    "customKeywords": ["resolution", "certain", "confirmed", "official"]
  },
  "riskParameters": {
    "budget": 100,
    "maxPerPosition": 25,
    "maxConcurrentPositions": 3,
    "minEdgeThreshold": 0.03,
    "kellyFraction": 0.25
  },
  "execution": {
    "autoExecute": false,
    "cronInterval": "4h"
  },
  "strategy": {
    "focus": "near-certainty outcomes",
    "approach": "Wait for markets that are near resolution with high confidence outcomes",
    "targetMarkets": [
      "Binary outcomes with clear resolution criteria",
      "Events with official confirmation pending",
      "Markets with regulatory deadlines"
    ],
    "avoidMarkets": [
      "Prediction markets with subjective outcomes",
      "Sports betting",
      "Long-term speculation",
      "Meme/gaming markets"
    ]
  }
}