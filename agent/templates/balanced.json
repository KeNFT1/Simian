{
  "name": "Balanced Geopolitical Intelligence",
  "description": "Moderate risk with focus on geopolitical and economic events",
  "template": "balanced",
  "marketFilters": {
    "excludeSports": true,
    "excludeMeme": true,
    "minVolume": 10000,
    "priceRange": {
      "min": 10,
      "max": 90
    },
    "maxDaysToResolution": 180
  },
  "intelligenceSources": {
    "hackernews": true,
    "reddit": true,
    "bbc": true,
    "googleNews": true,
    "nitter": true,
    "customKeywords": ["ukraine", "china", "fed", "election", "iran", "bitcoin", "inflation", "gdp", "sanctions"]
  },
  "riskParameters": {
    "budget": 50,
    "maxPerPosition": 10,
    "maxConcurrentPositions": 5,
    "minEdgeThreshold": 0.04,
    "kellyFraction": 0.25
  },
  "execution": {
    "autoExecute": false,
    "cronInterval": "4h"
  },
  "strategy": {
    "focus": "geopolitical and economic intelligence",
    "approach": "Use multiple news sources to identify information edges in political and economic markets",
    "targetMarkets": [
      "Geopolitical events and conflicts",
      "Economic indicators and Fed decisions",
      "Election outcomes and political events",
      "Cryptocurrency and technology adoption",
      "International relations and sanctions"
    ],
    "avoidMarkets": [
      "Sports betting",
      "Gaming/entertainment speculation",
      "Pure price speculation without fundamentals"
    ]
  }
}